# ============================================================
# Lo-fi 房间电台 · 环境变量示例
# 用法：复制为 .env.local（本地开发）或在 Vercel 项目设置里逐条填入
# 注意：所有 NEXT_PUBLIC_ 开头的变量都会暴露给浏览器，绝不要放密钥
# ============================================================

# ---- Supabase（必填）----
# Supabase 控制台 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 密钥：只允许在服务端使用（上传、审核、私密音频签名）
SUPABASE_SERVICE_ROLE_KEY=

# ---- 站长身份（必填）----
# 只有这个邮箱登录后才算管理员（与数据库 profiles.role = 'admin' 二选一满足即可）
ADMIN_EMAIL=

# ---- 站点信息（可选，有默认值）----
NEXT_PUBLIC_SITE_NAME=Lo-fi 房间电台
# 部署后改成正式域名，用于生成 sitemap / OG 图；本地留空即可
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- 树洞防滥用（可选，有默认值）----
# 给访客 IP 做哈希用的盐，随便一串随机字符；改了之后旧的 ip_hash 会失效
TREEHOLE_IP_SALT=please-change-this-salt
# 单次投递的最小间隔（秒）与每日上限
TREEHOLE_MIN_INTERVAL_SECONDS=60
TREEHOLE_DAILY_LIMIT=10

# ---- 上传限制（可选，有默认值，单位 MB）----
NEXT_PUBLIC_MAX_AUDIO_MB=25
NEXT_PUBLIC_MAX_IMAGE_MB=5

# ---- 天气（可选，有默认值）----
# 服务端专用，不要加 NEXT_PUBLIC_ 前缀。
# 数据来自 Open-Meteo：免费、不需要密钥。
# 这三项只是**兜底值** —— 后台「站点设置 → 外部数据源」里填了就以那边为准，
# 所以改城市不用重新部署。不填就是上海。
WEATHER_LAT=31.2304
WEATHER_LON=121.4737
WEATHER_CITY=上海

# 注：每日一句用的是 Hitokoto（https://v1.hitokoto.cn/），
# 同样免费无密钥，所以没有对应的环境变量。

# ---- 功能总闸（可选，默认都是 true）----
# 服务端专用。后台「站点设置」里各有一个单独的开关，这里是另一道闸 ——
# 两个都开才会真的生效。适合"暂时不想让站点发任何外部请求"的时候用。
#
# ⚠️ 写成 false / 0 / off / no 都算关；别写别的词（拼错会当成默认值 true）。
# 实时电台（SomaFM + 中文台）
RADIO_ENABLED=true
# 星空图（纯本地计算，不联网；关掉只是不渲染）
CELESTIAL_ENABLED=true
